<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>管理类考研 · 十大误区扫雷</title>
    <style>
        /* ===== 苹果风格重置 & 基础 ===== */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", system-ui, sans-serif;
            background: #f5f7fa;
            padding: 30px 20px;
            color: #1c1c1e;
            -webkit-font-smoothing: antialiased;
        }

        .app {
            max-width: 1280px;
            width: 100%;
        }

        /* ===== 头部 - 苹果风格 ===== */
        .header {
            text-align: center;
            margin-bottom: 52px;
            padding: 0 16px;
        }

        .header-title {
            font-size: 42px;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: #1c1c1e;
            margin-bottom: 6px;
            background: linear-gradient(135deg, #1c1c1e 0%, #2c3e4e 80%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .header-sub {
            font-size: 17px;
            font-weight: 400;
            color: #6c6c70;
            letter-spacing: 0.3px;
            margin-top: 4px;
        }

        .header-sub span {
            color: #007aff;
            font-weight: 500;
        }

        /* ===== 统计栏 - 轻量胶囊 ===== */
        .stats {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-top: 24px;
            flex-wrap: wrap;
        }

        .stats-item {
            font-size: 14px;
            font-weight: 400;
            color: #6c6c70;
            background: rgba(255, 255, 255, 0.7);
            padding: 6px 22px;
            border-radius: 40px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.02), 0 0 0 1px rgba(0, 0, 0, 0.02);
            transition: all 0.2s ease;
        }

        .stats-item strong {
            font-weight: 600;
            color: #1c1c1e;
        }

        .stats-item .num-correct {
            color: #34c759;
        }

        .stats-item .num-wrong {
            color: #ff3b30;
        }

        .stats-item .num-total {
            color: #1c1c1e;
        }

        /* ===== 卡片网格 ===== */
        .grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 20px;
            margin-top: 8px;
        }

        /* ===== 卡片容器 ===== */
        .card-wrapper {
            perspective: 1200px;
            height: 340px;
            cursor: pointer;
            outline: none;
            -webkit-tap-highlight-color: transparent;
        }

        .card {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform 0.7s cubic-bezier(0.23, 1, 0.32, 1);
            transform-style: preserve-3d;
            border-radius: 24px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04), 0 0 0 1px rgba(0, 0, 0, 0.02);
        }

        .card.flipped {
            transform: rotateY(180deg);
        }

        /* ===== 卡片面通用 ===== */
        .card-face {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 24px;
            display: flex;
            flex-direction: column;
            padding: 32px 24px 24px;
            overflow: hidden;
        }

        /* ---- 正面 - 极简白 ---- */
        .card-front {
            background: #ffffff;
            transform: rotateY(0deg);
            z-index: 2;
            border: 1px solid rgba(0, 0, 0, 0.02);
            box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.02);
        }

        .card-front .card-icon {
            font-size: 36px;
            line-height: 1.2;
            margin-bottom: 12px;
            display: block;
            opacity: 0.9;
        }

        .card-front .card-number {
            font-size: 13px;
            font-weight: 600;
            color: #8e8e93;
            letter-spacing: 0.5px;
            margin-bottom: 14px;
            text-transform: uppercase;
        }

        .card-front .card-number .badge {
            background: #f2f4f7;
            padding: 2px 14px;
            border-radius: 30px;
            font-size: 12px;
            color: #6c6c70;
        }

        .card-front .card-statement {
            flex: 1;
            font-size: 18px;
            font-weight: 500;
            color: #1c1c1e;
            line-height: 1.6;
            display: flex;
            align-items: center;
            letter-spacing: -0.2px;
        }

        .card-front .card-statement .quote {
            color: #c6c8cc;
            font-size: 24px;
            font-weight: 300;
            margin-right: 4px;
            line-height: 1;
        }

        .card-front .card-hint {
            margin-top: auto;
            text-align: center;
            font-size: 13px;
            color: #8e8e93;
            letter-spacing: 0.3px;
            padding-top: 16px;
            border-top: 1px solid rgba(0, 0, 0, 0.04);
            transition: color 0.3s;
            font-weight: 400;
        }

        .card-wrapper:hover .card-hint {
            color: #007aff;
        }

        .card-front .card-hint .icon {
            display: inline-block;
            transition: transform 0.3s;
            margin-right: 4px;
        }

        .card-wrapper:hover .card-hint .icon {
            transform: translateX(3px);
        }

        /* ---- 背面 - 仅正确/错误，无解释 ---- */
        .card-back {
            transform: rotateY(180deg);
            z-index: 1;
            justify-content: center;
            align-items: center;
            text-align: center;
            border: 1px solid rgba(0, 0, 0, 0.02);
        }

        .card-back.correct {
            background: #e8f5e9;
            box-shadow: inset 0 0 0 1px rgba(52, 199, 89, 0.15);
        }

        .card-back.wrong {
            background: #fce4ec;
            box-shadow: inset 0 0 0 1px rgba(255, 59, 48, 0.12);
        }

        .card-back .result-icon {
            font-size: 56px;
            line-height: 1;
            margin-bottom: 8px;
            filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.02));
        }

        .card-back .result-label {
            font-size: 38px;
            font-weight: 700;
            letter-spacing: 2px;
        }

        .card-back.correct .result-label {
            color: #1e7e34;
        }

        .card-back.wrong .result-label {
            color: #b71c1c;
        }

        /* 极简返回提示（仅作为辅助，不影响“只显示正确/错误”的主旨） */
        .card-back .back-subtle {
            position: absolute;
            bottom: 18px;
            left: 0;
            right: 0;
            font-size: 11px;
            color: rgba(0, 0, 0, 0.15);
            letter-spacing: 0.5px;
            font-weight: 400;
        }

        /* ===== 卡片顶部光效 ===== */
        .card-front::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.02), transparent);
        }

        .card-back.correct::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: #34c759;
            opacity: 0.3;
            border-radius: 24px 24px 0 0;
        }

        .card-back.wrong::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: #ff3b30;
            opacity: 0.3;
            border-radius: 24px 24px 0 0;
        }

        /* ===== 重置按钮 - 苹果风格 ===== */
        .reset-wrap {
            text-align: center;
            margin-top: 44px;
        }

        .reset-btn {
            background: transparent;
            border: none;
            color: #007aff;
            padding: 10px 36px;
            border-radius: 40px;
            font-size: 16px;
            font-weight: 500;
            letter-spacing: 0.3px;
            cursor: pointer;
            transition: all 0.25s ease;
            font-family: inherit;
            background: rgba(0, 122, 255, 0.04);
            border: 1px solid rgba(0, 122, 255, 0.08);
        }

        .reset-btn:hover {
            background: rgba(0, 122, 255, 0.08);
            border-color: rgba(0, 122, 255, 0.15);
            transform: scale(1.02);
        }

        .reset-btn:active {
            transform: scale(0.94);
            background: rgba(0, 122, 255, 0.12);
        }

        /* ===== 响应式 ===== */
        @media (max-width: 1200px) {
            .grid {
                grid-template-columns: repeat(4, 1fr);
                gap: 18px;
            }
            .card-wrapper {
                height: 320px;
            }
        }

        @media (max-width: 992px) {
            .grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
            }
            .card-wrapper {
                height: 300px;
            }
            .header-title {
                font-size: 36px;
            }
            .card-front .card-statement {
                font-size: 16px;
            }
            .card-back .result-label {
                font-size: 32px;
            }
        }

        @media (max-width: 680px) {
            .grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 14px;
            }
            .card-wrapper {
                height: 280px;
            }
            .header-title {
                font-size: 30px;
            }
            .header-sub {
                font-size: 15px;
            }
            .card-front .card-statement {
                font-size: 15px;
            }
            .card-face {
                padding: 24px 18px 18px;
            }
            .card-front .card-icon {
                font-size: 30px;
            }
            .card-back .result-icon {
                font-size: 44px;
            }
            .card-back .result-label {
                font-size: 28px;
            }
            .stats {
                gap: 14px;
            }
            .stats-item {
                font-size: 13px;
                padding: 4px 16px;
            }
        }

        @media (max-width: 440px) {
            .grid {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }
            .card-wrapper {
                height: 250px;
            }
            .header-title {
                font-size: 26px;
            }
            .header-sub {
                font-size: 13px;
            }
            .card-front .card-statement {
                font-size: 14px;
                line-height: 1.5;
            }
            .card-face {
                padding: 18px 14px 14px;
            }
            .card-front .card-number {
                font-size: 11px;
                margin-bottom: 8px;
            }
            .card-front .card-icon {
                font-size: 26px;
                margin-bottom: 6px;
            }
            .card-back .result-icon {
                font-size: 36px;
            }
            .card-back .result-label {
                font-size: 24px;
                letter-spacing: 1px;
            }
            .card-front .card-hint {
                font-size: 11px;
                padding-top: 10px;
            }
            .reset-btn {
                font-size: 14px;
                padding: 8px 28px;
            }
            .card-back .back-subtle {
                font-size: 10px;
                bottom: 12px;
            }
        }

        @media (max-width: 360px) {
            .grid {
                grid-template-columns: 1fr;
                max-width: 300px;
                margin: 0 auto;
            }
            .card-wrapper {
                height: 260px;
            }
        }

        /* ===== 进场动画 ===== */
        .card-wrapper {
            opacity: 0;
            transform: translateY(24px) scale(0.96);
            animation: cardEntrance 0.65s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }

        .card-wrapper:nth-child(1) {
            animation-delay: 0.04s;
        }
        .card-wrapper:nth-child(2) {
            animation-delay: 0.08s;
        }
        .card-wrapper:nth-child(3) {
            animation-delay: 0.12s;
        }
        .card-wrapper:nth-child(4) {
            animation-delay: 0.16s;
        }
        .card-wrapper:nth-child(5) {
            animation-delay: 0.20s;
        }
        .card-wrapper:nth-child(6) {
            animation-delay: 0.24s;
        }
        .card-wrapper:nth-child(7) {
            animation-delay: 0.28s;
        }
        .card-wrapper:nth-child(8) {
            animation-delay: 0.32s;
        }
        .card-wrapper:nth-child(9) {
            animation-delay: 0.36s;
        }
        .card-wrapper:nth-child(10) {
            animation-delay: 0.40s;
        }

        @keyframes cardEntrance {
            0% {
                opacity: 0;
                transform: translateY(24px) scale(0.96);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ===== 辅助 ===== */
        .card-wrapper.flipping {
            pointer-events: none;
        }

        /* 让卡片正面可选中，背面的纯文本更清晰 */
        .card-back .result-label,
        .card-back .result-icon {
            user-select: none;
        }
    </style>
</head>
<body>

    <div class="app" role="main">
        <!-- 头部 -->
        <header class="header">
            <h1 class="header-title">管理类考研常见十大误区</h1>
            <p class="header-sub">
                点击卡片翻转 · 验证你的判断 <span>✔</span>
            </p>
            <div class="stats" id="stats" aria-live="polite">
                <span class="stats-item">📦 总计 <strong class="num-total" id="totalCount">10</strong></span>
                <span class="stats-item">✅ 正确 <strong class="num-correct" id="correctCount">0</strong></span>
                <span class="stats-item">❌ 错误 <strong class="num-wrong" id="wrongCount">0</strong></span>
                <span class="stats-item">🔄 已翻 <strong id="flippedCount">0</strong></span>
            </div>
        </header>

        <!-- 卡片网格 -->
        <div class="grid" id="cardGrid" role="list">
            <!-- 由 JavaScript 动态生成 -->
        </div>

        <!-- 重置 -->
        <div class="reset-wrap">
            <button class="reset-btn" id="resetBtn" type="button">⟳ 重置全部卡片</button>
        </div>
    </div>

    <script>
        // ============================================================
        //  数据：10个误区 + 象征符号 + 正确/错误标记
        //  ⚠️ 第 10 条已修改为 correct: true
        // ============================================================
        const cardData = [{
            id: 1,
            icon: '📚',
            statement: '考研英语和四、六级词汇是两套体系',
            correct: false
        }, {
            id: 2,
            icon: '🎯',
            statement: '考研英语二的阅读，很多题目不需要读懂全文，找准定位句就能做对',
            correct: true
        }, {
            id: 3,
            icon: '📄',
            statement: '考研英语作文我背20篇模板，考场直接套就好了',
            correct: false
        }, {
            id: 4,
            icon: '⏳',
            statement: '考研英语完形填空只占10分，分值太低，不用专门练',
            correct: false
        }, {
            id: 5,
            icon: '📐',
            statement: '管综数学很难，要重新学很多东西，要会高等数学、线性代数、概率论',
            correct: false
        }, {
            id: 6,
            icon: '🧩',
            statement: '管综逻辑题要学专业的形式逻辑，背公式、推符号',
            correct: false
        }, {
            id: 7,
            icon: '🕐',
            statement: '管综考试180分钟，时间很充裕，慢慢做就行',
            correct: false
        }, {
            id: 8,
            icon: '✍️',
            statement: '管综写作就是写议论文，和高考作文差不多，考前不用特意练习',
            correct: false
        }, {
            id: 9,
            icon: '💪',
            statement: '考研要每天学4小时以上，时间越长越好',
            correct: false
        }, {
            id: 10,
            icon: '⚖️',
            statement: '管综论说文的评分标准中，"论证质量"远比"文采"重要',
            correct: true   // ✅ 已修改：由 false 改为 true
        }];

        // ============================================================
        //  状态
        // ============================================================
        let flippedStates = new Array(cardData.length).fill(false);
        let totalFlipped = 0;

        // ============================================================
        //  DOM 引用
        // ============================================================
        const grid = document.getElementById('cardGrid');
        const totalCountEl = document.getElementById('totalCount');
        const correctCountEl = document.getElementById('correctCount');
        const wrongCountEl = document.getElementById('wrongCount');
        const flippedCountEl = document.getElementById('flippedCount');
        const resetBtn = document.getElementById('resetBtn');

        // ============================================================
        //  渲染
        // ============================================================
        function renderCards() {
            grid.innerHTML = '';
            cardData.forEach((data, index) => {
                const wrapper = document.createElement('div');
                wrapper.className = 'card-wrapper';
                wrapper.setAttribute('role', 'listitem');
                wrapper.dataset.index = index;
                wrapper.setAttribute('tabindex', '0');
                wrapper.setAttribute('aria-label', `点击翻转：${data.statement}`);

                const card = document.createElement('div');
                card.className = 'card';
                if (flippedStates[index]) {
                    card.classList.add('flipped');
                }

                // ---- 正面 ----
                const front = document.createElement('div');
                front.className = 'card-face card-front';
                front.innerHTML = `
                    <span class="card-icon">${data.icon}</span>
                    <div class="card-number"><span class="badge">#${String(data.id).padStart(2, '0')}</span></div>
                    <div class="card-statement"><span class="quote">“</span>${data.statement}<span class="quote">”</span></div>
                    <div class="card-hint"><span class="icon">↻</span> 轻点翻转</div>
                `;

                // ---- 背面：仅显示 正确/错误，无任何解释 ----
                const back = document.createElement('div');
                const isCorrect = data.correct;
                back.className = `card-face card-back ${isCorrect ? 'correct' : 'wrong'}`;
                back.innerHTML = `
                    <div class="result-icon">${isCorrect ? '✅' : '❌'}</div>
                    <div class="result-label">${isCorrect ? '正确' : '错误'}</div>
                    <div class="back-subtle">·</div>
                `;

                card.appendChild(front);
                card.appendChild(back);
                wrapper.appendChild(card);
                grid.appendChild(wrapper);

                // 点击翻转
                wrapper.addEventListener('click', function(e) {
                    e.stopPropagation();
                    toggleCard(index);
                });

                // 键盘支持
                wrapper.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        toggleCard(index);
                    }
                });
            });

            updateStats();
        }

        // ============================================================
        //  翻转逻辑
        // ============================================================
        function toggleCard(index) {
            const wrapper = document.querySelector(`.card-wrapper[data-index="${index}"]`);
            if (!wrapper) return;
            const card = wrapper.querySelector('.card');
            if (!card) return;
            if (wrapper.classList.contains('flipping')) return;

            wrapper.classList.add('flipping');

            const currentlyFlipped = flippedStates[index];
            const newState = !currentlyFlipped;
            flippedStates[index] = newState;

            if (newState) {
                card.classList.add('flipped');
                totalFlipped += 1;
            } else {
                card.classList.remove('flipped');
                totalFlipped -= 1;
            }

            // 更新 aria-label
            const data = cardData[index];
            const label = newState ?
                `已翻转：${data.statement} —— ${data.correct ? '✅ 正确' : '❌ 错误'}` :
                `点击翻转：${data.statement}`;
            wrapper.setAttribute('aria-label', label);

            setTimeout(() => {
                wrapper.classList.remove('flipping');
            }, 700);

            updateStats();
        }

        // ============================================================
        //  更新统计
        // ============================================================
        function updateStats() {
            let correctCount = 0;
            let wrongCount = 0;
            flippedStates.forEach((flipped, idx) => {
                if (flipped) {
                    if (cardData[idx].correct) {
                        correctCount += 1;
                    } else {
                        wrongCount += 1;
                    }
                }
            });

            correctCountEl.textContent = correctCount;
            wrongCountEl.textContent = wrongCount;
            flippedCountEl.textContent = totalFlipped;
            totalCountEl.textContent = cardData.length;
        }

        // ============================================================
        //  重置
        // ============================================================
        function resetAll() {
            const allUnflipped = flippedStates.every(state => state === false);
            if (allUnflipped) {
                resetBtn.style.transform = 'scale(0.94)';
                setTimeout(() => { resetBtn.style.transform = ''; }, 200);
                return;
            }

            flippedStates.fill(false);
            totalFlipped = 0;

            document.querySelectorAll('.card-wrapper').forEach((wrapper, idx) => {
                const card = wrapper.querySelector('.card');
                if (card) {
                    card.classList.remove('flipped');
                }
                wrapper.classList.remove('flipping');
                // 重置 aria-label
                const data = cardData[idx];
                wrapper.setAttribute('aria-label', `点击翻转：${data.statement}`);
            });

            updateStats();

            resetBtn.style.transform = 'scale(0.94)';
            setTimeout(() => { resetBtn.style.transform = ''; }, 200);
        }

        // ============================================================
        //  启动
        // ============================================================
        renderCards();
        resetBtn.addEventListener('click', resetAll);

        console.log('✅ 管理类考研误区扫雷已加载 (苹果风)');
        console.log(`📊 共 ${cardData.length} 张卡片，正确 ${cardData.filter(d => d.correct).length} 条，错误 ${cardData.filter(d => !d.correct).length} 条。`);
    </script>

</body>
</html>
